{
  "pool_size": 500,
  "watch_range": [
    500,
    1500
  ],
  "route_pool_map": {
    "reversal": 500,
    "momentum": 200
  },
  "momentum_route_weight": 0.5,
  "liquidity_filter": {
    "enabled": true,
    "min_avg_amount_20d": 50000000,
    "min_avg_turnover_rate": 0.01
  },
  "industry_limits": {
    "max_single_stock": 0.08,
    "max_l2_sector": 0.25,
    "max_l1_parent": 0.35,
    "max_l1_deviation_pp": 8
  },
  "eligibility_filter": {
    "exclude_st": true,
    "exclude_delisting": true,
    "min_listing_days": 60,
    "exclude_suspended": true
  },
  "dual_pool_compare": false,
  "regime_tag": "下跌市验证（截面区间 2026-06-26~2026-10-12）",
  "regime_note": "扩池结论（反转路线 TOP500 占优）来自 2026-06-26~2026-10-12 单一下跌市回测；上涨市数据积累后须强制复盘，不得直接外推。渲染层已改为用 factor_ic.json 有效截面区间动态覆盖本静态值。",
  "regime_review_trigger": "累计 ≥20 个上涨市交易日（上证 20 日均线向上且中位涨幅>0）后重跑 backtest_universe.py 并复核扩池结论",
  "fetch": {
    "pages": 15,
    "page_size": 100,
    "total_n": 1500
  },
  "coverage_guard": {
    "min_pool_coverage": 0.96,
    "meltdown_coverage": 0.9
  },
  "workflow": {
    "timeout_minutes": 300,
    "step_warn_ratio": 1.5
  },
  "monitoring": {
    "stale_data_alert": {
      "enabled": true,
      "max_stale_trading_days": 1,
      "note": "指数日线最新交易日落后北京当日>1个交易日即判定停更；本地兜底链路(run_daily_local.sh)为可靠主路径，Actions 海外 runner 慢易超时"
    },
    "ic_alert": {
      "enabled": true,
      "recommendation_ic_nw_t_hi": -2.0,
      "recommendation_win_rate_lo": 40,
      "composite_ic_nw_t_lo": 2.0,
      "note": "预测力安全门阈值(与 factor_eval._risk_gate 同源)：推荐组合 T+1 NW t≤-2 或 胜率<40% → high_risk(不机械跟单)；综合分 NW t<2 → 无显著正预测力"
    }
  }
}